  "content": [
    {
      "id": "quran-001",
      "date": "*",
      "type": "QURAN",
      "arabic": "يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
      "english": "Believers, seek help through patience and prayer. Surely Allah is with those who remain patient.",
      "reference": "Surah Al-Baqarah 2:153",
      "scholar": ""
    },
    {
      "id": "hadith-001",
      "date": "*",
      "type": "HADITH",
      "arabic": "إِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ",
      "english": "Actions are judged by intentions.",
      "reference": "Riyad as-Salihin Hadith 1",
      "scholar": ""
    },
    {
      "id": "wisdom-001",
      "date": "*",
      "type": "SCHOLAR",
      "arabic": "كُلُّ أَحَدٍ يُؤْخَذُ مِنْ قَوْلِهِ وَيُرَدُّ إِلَّا صَاحِبَ هَذَا الْقَبْرِ",
      "english": "Everyone’s statement may be accepted or rejected except the occupant of this grave.",
      "reference": "Jami Bayan al-Ilm",
      "scholar": "Imam Malik"
    }
  ]
}
